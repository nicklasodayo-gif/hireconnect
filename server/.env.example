# Server
PORT=4000
DB_PATH=./hireconnect.db
NODE_ENV=development

# CORS: comma-separated list of allowed frontend origins. If unset:
#  - production: no CORS header is sent (same-origin only — fail closed)
#  - non-production: the request's Origin is reflected back (dev convenience)
# ALLOWED_ORIGINS=https://hireconnect.co.ke,https://app.hireconnect.co.ke

# Seed data (server/src/seed.ts) — override before seeding anything beyond
# local/demo use. Never reuse these in a real deployment.
SEED_DEFAULT_PASSWORD=Password123!
SEED_ADMIN_PASSWORD=AdminPass123!

# --- Not yet wired up (documented for the production migration path) ---
# DATABASE_URL=postgres://user:password@localhost:5432/hireconnect
# JWT_SECRET=replace-with-a-long-random-string
# EMAIL_PROVIDER=resend            # resend | sendgrid | smtp
# EMAIL_API_KEY=
# EMAIL_FROM=no-reply@hireconnect.co.ke
# UPLOAD_MAX_BYTES=5242880
